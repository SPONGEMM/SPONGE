+/*! \brief Flush pending stdio bytes to the host environment without closing.
+ *
+ *  Mirrors fflush(FILE*) for the encapsulated stream. XTC frames carry their
+ *  own self-describing header, so nothing is appended on close; flushing at a
+ *  frame boundary is therefore a complete durability guarantee against an
+ *  abrupt process termination (it does not fsync to the storage device).
+ *
+ *  \param xfp  Pointer to an abstract XDRFILE datatype
+ *
+ *  \return     exdrOK on success, an enum error code otherwise.
+ */
+int xdrfile_flush(XDRFILE* xfp);
+
+/*! \brief Install a frame-aligned stdio buffer on an already opened handle.
+ *
+ *  Must be called after xdrfile_open() and before the first write. Sizing the
+ *  buffer to whole frames keeps a single frame from straddling a buffer
+ *  boundary, so an interrupted write drops the whole frame instead of leaving
+ *  a partial one on disk. Also reduces write syscalls by orders of magnitude.
+ *
+ *  \param xfp         Pointer to an abstract XDRFILE datatype
+ *  \param frame_bytes Payload size of one frame in bytes; <=0 disables
+ *  \param frames      Number of frames the buffer should hold; <=0 disables
+ *
+ *  \return     exdrOK on success, exdrNOMEM when allocation fails, or the
+ *              error code reported by setvbuf().
+ */
+int xdrfile_setvbuf(XDRFILE* xfp, size_t frame_bytes, int frames);
+
