+/* ------------------------------------------------------------------------
+ * SPONGE local extensions (not part of upstream libxdrfile).
+ * See patches/0001-sponge-runtime-extensions.patch and README.md.
+ * ------------------------------------------------------------------------ */
+
+int xdrfile_flush(XDRFILE* xfp) {
+    if (xfp == NULL || xfp->fp == NULL) {
+        return exdrCLOSE;
+    }
+    return fflush(xfp->fp) == 0 ? exdrOK : exdrCLOSE;
+}
+
+int xdrfile_setvbuf(XDRFILE* xfp, size_t frame_bytes, int frames) {
+    size_t total;
+    char* buffer;
+
+    if (xfp == NULL || xfp->fp == NULL) {
+        return exdrCLOSE;
+    }
+    if (frame_bytes == 0 || frames <= 0) {
+        return exdrOK; /* keep the stdio default */
+    }
+    if (xfp->stdio_buffer != NULL) {
+        return exdrOK; /* already installed; setvbuf only applies once */
+    }
+
+    total = frame_bytes * (size_t)frames;
+    if (total / frame_bytes != (size_t)frames) {
+        return exdrNOMEM; /* size overflow */
+    }
+    buffer = (char*)malloc(total);
+    if (buffer == NULL) {
+        return exdrNOMEM;
+    }
+    if (setvbuf(xfp->fp, buffer, _IOFBF, total) != 0) {
+        free(buffer);
+        return exdrCLOSE;
+    }
+    xfp->stdio_buffer = buffer;
+    return exdrOK;
+}
